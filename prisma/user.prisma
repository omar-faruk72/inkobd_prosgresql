
model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified DateTime? 
  password      String 
  photoUrl      String? 
  age           Int?
  phone         String?
  address       String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}